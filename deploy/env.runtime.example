# Explorer frontend — single complete runtime env
# =================================================
# ONE file configures the whole frontend at deploy time. Copy to .env, fill in
# the values, and docker-compose passes them into the container. No preset, no
# image rebuild, nothing chain-specific baked in.
#
#   ENVS_PRESET=none  -> skip the built-in preset entirely; this .env is the only
#   source of truth. (Put a preset name here instead if you WANT it as a fallback
#   for anything you don't set below.)
#
# Values shown are the QDay2 testnet example - change them for another chain.
ENVS_PRESET=none

# -- Chain identity --
NEXT_PUBLIC_NETWORK_ID=44005
NEXT_PUBLIC_NETWORK_NAME=QDay2 Testnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=QDay2
NEXT_PUBLIC_IS_TESTNET=true

# -- Native currency --
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=QDAY
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=QDAY
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_CURRENCY_WEI_NAME=bit
NEXT_PUBLIC_NETWORK_CURRENCY_GWEI_NAME=Qbit

# -- RPC shown to users (MetaMask "Add Network") --
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc-test.qday.io

# -- Explorer app + API hosts (public-facing) --
NEXT_PUBLIC_APP_HOST=explorer-test.qday.io
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_API_HOST=explorer-test.qday.io
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# -- Stats / visualizer services --
NEXT_PUBLIC_STATS_API_HOST=https://explorer-test.qday.io
NEXT_PUBLIC_VISUALIZE_API_HOST=https://explorer-test.qday.io

# -- UI --
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_NAVIGATION_LAYOUT=horizontal
NEXT_PUBLIC_COLOR_THEME_DEFAULT=dark

# -- Secrets (set per environment; never commit real values) --
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=CHANGE_ME
