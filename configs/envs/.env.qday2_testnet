# Set of ENVs for QDay2 Testnet explorer
# https://explorer-test.qday.io

# Local ENVs
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=explorer-test.qday.io
NEXT_PUBLIC_APP_PORT=80
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# Instance ENVs
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_HOST=explorer-test.qday.io
NEXT_PUBLIC_API_PROTOCOL=https

# Network configuration
NEXT_PUBLIC_NETWORK_NAME=QDAY2 Testnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=QDAY2
NEXT_PUBLIC_NETWORK_ID=44005
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc-test.qday.io
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=QDAY
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=QDAY
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_CURRENCY_WEI_NAME=bit
NEXT_PUBLIC_NETWORK_CURRENCY_GWEI_NAME=Qbit
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation

# Stats and visualization
NEXT_PUBLIC_STATS_API_HOST=https://explorer-test.qday.io
NEXT_PUBLIC_VISUALIZE_API_HOST=https://explorer-test.qday.io

# UI configuration
# daily_txs requires stats service — enabled since stats is deployed (v2.3.0)
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_NAVIGATION_LAYOUT=horizontal
NEXT_PUBLIC_COLOR_THEME_DEFAULT=dark

# Branding
NEXT_PUBLIC_NETWORK_LOGO=file://./public/static/logos/qday-logo-horizontal-blue.png
NEXT_PUBLIC_NETWORK_ICON=file://./public/static/logos/qday-logo-horizontal-blue.png
NEXT_PUBLIC_OG_DESCRIPTION=QDAY2 Testnet Explorer — explore blocks, transactions, addresses and tokens on the QDAY2 test network.
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# API spec
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml

# Testnet flag
NEXT_PUBLIC_IS_TESTNET=true
